# Which model backend serves every request. "cerebras" (default) is free
# and safe to use in production. "anthropic" uses Claude if you'd rather
# pay for stronger, more consistent JSON output.
AI_PROVIDER=cerebras

# Get a free key at https://cloud.cerebras.ai (no credit card required)
CEREBRAS_API_KEY=your-cerebras-api-key-here
# Optional - defaults to gpt-oss-120b
CEREBRAS_MODEL=gpt-oss-120b

# Only needed if AI_PROVIDER=anthropic
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Max requests allowed per IP address per hour, enforced by this app's own
# limiter (separate from Cerebras's own free-tier limits - see README).
RATE_LIMIT_PER_HOUR=20
