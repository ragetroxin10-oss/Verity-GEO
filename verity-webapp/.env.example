# Which model backend serves every request. This project is configured for Groq.
AI_PROVIDER=groq

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Optional - this is a current Groq production model.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative provider
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Only needed if AI_PROVIDER=anthropic
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Max requests allowed per IP address per hour, enforced by this app's own
# limiter (separate from Groq's own limits - see README).
RATE_LIMIT_PER_HOUR=20
